# Copy to .env for local development.
# On Railway/Render, set these as actual environment variables in the
# service settings instead of committing a .env file.

PORT=4000

# Option A: a single connection string (Railway's MySQL plugin provides
# this automatically, usually as MYSQL_URL or MYSQL_PUBLIC_URL).
DATABASE_URL=mysql://user:password@localhost:3306/aluminum_store

# Option B: discrete vars, used only if DATABASE_URL is not set.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aluminum_store

# Long random string — used to sign login tokens. Generate a new one for
# production, e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# The exact origin your frontend is served from (no trailing slash).
# Multiple origins can be comma-separated.
CORS_ORIGIN=http://localhost:5173

# Credentials for the admin account created by `npm run seed`.
SEED_ADMIN_IDENTIFIER=admin@example.com
SEED_ADMIN_PASSWORD=change-this-password
SEED_ADMIN_NAME=Admin
